#Fase 7 (2026-09-08): este servicio ya NO se conecta directo a Postgres — sincroniza vía la API
#nueva de gestorBQ (envios/views.py::api_seguimiento_masivo/api_seguimiento_por_ot). Preparado para
#correr en cualquier hosting (self-hosted o Railway), ya que solo necesita HTTPS de salida.
GESTORBQ_API_URL=https://gestor.bioquimica.cl
#Header X-API-KEY contra esa API — mismo valor que gestorBQ.settings.SEGUIMIENTO_API_KEY (usar uno
#DISTINTO por ambiente, prod y test no deben compartir clave).
SEGUIMIENTO_API_KEY=

#Ventana de días del masivo Y umbral de autolimpieza del cache local (misma variable para ambos).
DIAS_RETENCION=25
#Cada cuántos minutos se re-sincroniza el cache en memoria.
SYNC_INTERVALO_MINUTOS=5
